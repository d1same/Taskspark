<?xml version="1.0"?>
<Container version="2">
  <Name>Taskspark</Name>
  <Repository>ghcr.io/d1same/taskspark:latest</Repository>
  <Registry>https://github.com/d1same/Taskspark/pkgs/container/taskspark</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/d1same/Taskspark</Support>
  <Project>https://github.com/d1same/Taskspark</Project>
  <Overview>Family chore board and points board. The first phone sets a household code. Later phones wait until an approved phone accepts them. Runs as user 1000. The appdata folder must be writable by that user. To roll back, set the repository tag to an older version, for example ghcr.io/d1same/taskspark:0.1.0, instead of latest. Logs are in the container log.</Overview>
  <Category>HomeAutomation: Tools:</Category>
  <WebUI>http://[IP]:[PORT:7370]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/d1same/Taskspark/main/unraid/taskspark.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/d1same/Taskspark/main/public/icon-512.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Web UI" Target="7370" Default="7370" Mode="tcp" Description="Host port 7370 to container port 7370" Type="Port" Display="always" Required="true" Mask="false">7370</Config>
  <Config Name="Appdata" Target="/data" Default="/mnt/user/appdata/taskspark" Mode="rw" Description="Household database" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/taskspark</Config>
  <Config Name="TZ" Target="TZ" Default="America/New_York" Mode="" Description="Household timezone" Type="Variable" Display="always" Required="false" Mask="false">America/New_York</Config>
</Container>
